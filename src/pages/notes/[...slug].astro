---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes
    .filter((note) => note.id !== "README")
    .map((note) => ({
      params: { slug: note.id },
      props: { note },
    }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);

const h1 = headings.find((h) => h.depth === 1);
const title =
  h1?.text ?? note.id.split("/").pop()?.replace(/-/g, " ") ?? "Note";
---

<BaseLayout title={`Omar Tiffer - ${title}`}>
  <section
    class="min-h-[calc(100dvh-128px)] w-full px-4 sm:px-6 lg:px-8 py-12 max-w-screen-xl mx-auto"
  >
    <a
      href="/notes"
      class="text-base-content/70 hover:text-primary transition-colors duration-200 prose-lg"
    >
      &larr; Back to Notes
    </a>
    <article class="prose prose-lg max-w-none mt-8">
      <Content />
    </article>
  </section>
</BaseLayout>
