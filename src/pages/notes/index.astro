---
import { getEntry, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

const readme = await getEntry("notes", "README");
const { Content } = await render(readme!);
---

<BaseLayout title="Omar Tiffer - Notes">
  <section
    class="min-h-[calc(100dvh-128px)] w-full px-4 sm:px-6 lg:px-8 py-12 max-w-7xl mx-auto"
  >
    <article class="prose prose-lg max-w-none">
      <Content />
    </article>
  </section>
</BaseLayout>
